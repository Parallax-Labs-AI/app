{
  "identifier": "main",
  "description": "Native file dialogs, clipboard writes, and official model links for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default", "dialog:allow-open", "dialog:allow-save", "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{"url": "https://huggingface.co/parallaxlabs/*"}]
    }
  ]
}
