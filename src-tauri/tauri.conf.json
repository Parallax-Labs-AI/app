{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parallax App",
  "version": "0.5.2",
  "identifier": "xyz.parallaxstudios.labs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Parallax App",
        "width": 1180,
        "height": 790,
        "minWidth": 450,
        "minHeight": 560,
        "backgroundColor": "#111112"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Local AI chat by Parallax Labs",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
