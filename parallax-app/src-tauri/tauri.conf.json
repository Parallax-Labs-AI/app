{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "parallax-app",
  "version": "0.3.0",
  "identifier": "xyz.parallaxstudios.labs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
"windows": [
  {
    "title": "Parallax App",
    "width": 1200,
    "height": 850,
    "minWidth": 960,
    "minHeight": 700,
    "center": true,
    "backgroundColor": "#0a0a0a"
  }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
